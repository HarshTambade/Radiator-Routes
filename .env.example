# Browser build configuration. Every VITE_* value is public and compiled into
# the JavaScript bundle. Only put public Supabase project values here.

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Provider credentials belong in Supabase Edge Function secrets, never in a
# VITE_* variable or a checked-in .env file. Configure only the integrations
# this deployment uses:
#   supabase secrets set GROQ_API_KEY="..." ORS_API_KEY="..." OPENTRIPMAP_API_KEY="..." HF_API_KEY="..."
# Optional server-side model overrides:
#   supabase secrets set GROQ_MODEL="openai/gpt-oss-120b" GROQ_VISION_MODEL="qwen/qwen3.8-27b"
# Optional browser origins for the external REST/MCP API (exact origins,
# comma-separated); requests without an Origin header remain valid:
#   supabase secrets set PLATFORM_API_ALLOWED_ORIGINS="https://your-app.example"

# The provider proxies require an authenticated Supabase session. Open-Meteo,
# OpenStreetMap tiles, MapLibre, Wikipedia/Wikimedia, Web Speech, and the
# opt-in on-device WebLLM path do not use provider API credentials here.
